{
  "name": "mailcord",
  "version": "1.0.0",
  "description": "Send/receive custom-domain email through Discord via Resend",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "register-commands": "tsx src/bot/registerCommandsCli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.0.0",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.31.0",
    "fastify": "^4.0.0",
    "resend": "^3.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
